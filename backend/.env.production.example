# Variables para producción (Railway / Render / Fly / VPS).
# Cópialas al panel de variables del host; NUNCA subas un .env real al repo.

APP_NAME="FitCoach Pro"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate --show
APP_URL=https://api.tu-dominio.com
APP_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Base de datos (Neon). Usa la misma región que el host de la API.
# Con el host "-pooler" de Neon (PgBouncer) soportas más conexiones simultáneas.
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# La API usa tokens Sanctum, no sesiones ni cookies: no consultes la BD por nada de esto.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# El host termina el TLS: confía en su proxy para que las URLs salgan en https.
TRUSTED_PROXIES=*

# Imágenes de ejercicios en Cloudflare R2 (el disco local del host se borra en cada deploy).
EXERCISE_MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitcoach-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.tu-dominio.com

# Correo real (el mailer "log" dejaría los códigos de recuperación en texto plano en los logs).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

COACH_REGISTRATION_CODE=

# Solo en el primer arranque de una única instancia; luego quítalo.
RUN_MIGRATIONS=false
